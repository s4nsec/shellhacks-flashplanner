GEMINI_API_KEY=
# Or leave GEMINI_API_KEY empty and use Vertex AI with application default credentials:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# On Vercel, also set these so Vercel's OIDC token is swapped for a service account's credentials:
# GCP_PROJECT_NUMBER=123456789012
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# GCP_SERVICE_ACCOUNT_EMAIL=flashplanner-vercel@your-project-id.iam.gserviceaccount.com
GEMINI_MODEL=gemini-3.8-flash

GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

LANGUAGE=en

# SQLite recipe store; contains user trip settings/actions, never Places content.
SESSION_DB_PATH=sessions.sqlite3
